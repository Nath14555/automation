{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@/agent/*": ["src/agent/*"],
      "@/tools/*": ["src/tools/*"],
      "@/knowledge/*": ["src/knowledge/*"],
      "@/monitoring/*": ["src/monitoring/*"],
      "@/utils/*": ["src/utils/*"],
      "@louna/shared": ["../../packages/shared/src/index.ts"],
      "@louna/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*", "scripts/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist", "build"]
}
