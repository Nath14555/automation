{
  "orchestrator": {
    "name": "AI Marketing Agency Orchestrator",
    "version": "1.0.0",
    "description": "Orchestrateur central qui coordonne les 12 agents AI de l'agence de marketing",

    "agents": [
      {
        "id": "marketing-strategist",
        "file": "01-marketing-strategist.json",
        "category": "strategy",
        "priority": 1,
        "always_on": true
      },
      {
        "id": "content-creator",
        "file": "02-content-creator.json",
        "category": "content",
        "priority": 2,
        "always_on": true
      },
      {
        "id": "community-manager",
        "file": "03-community-manager.json",
        "category": "engagement",
        "priority": 2,
        "always_on": true
      },
      {
        "id": "seo-specialist",
        "file": "04-seo-specialist.json",
        "category": "acquisition",
        "priority": 3,
        "always_on": false
      },
      {
        "id": "media-buyer",
        "file": "05-media-buyer.json",
        "category": "acquisition",
        "priority": 2,
        "always_on": true
      },
      {
        "id": "email-marketer",
        "file": "06-email-marketer.json",
        "category": "nurturing",
        "priority": 3,
        "always_on": true
      },
      {
        "id": "sales-closer",
        "file": "07-sales-closer.json",
        "category": "conversion",
        "priority": 1,
        "always_on": true
      },
      {
        "id": "analytics-analyst",
        "file": "08-analytics-analyst.json",
        "category": "intelligence",
        "priority": 2,
        "always_on": true
      },
      {
        "id": "crm-manager",
        "file": "09-crm-manager.json",
        "category": "operations",
        "priority": 3,
        "always_on": true
      },
      {
        "id": "reputation-manager",
        "file": "10-reputation-manager.json",
        "category": "brand",
        "priority": 3,
        "always_on": false
      },
      {
        "id": "onboarding-specialist",
        "file": "11-onboarding-specialist.json",
        "category": "customer_success",
        "priority": 3,
        "always_on": false
      },
      {
        "id": "retention-specialist",
        "file": "12-retention-specialist.json",
        "category": "customer_success",
        "priority": 2,
        "always_on": true
      }
    ],

    "data_flow": {
      "acquisition_funnel": [
        "marketing-strategist -> content-creator -> community-manager -> sales-closer",
        "marketing-strategist -> media-buyer -> sales-closer",
        "marketing-strategist -> seo-specialist -> content-creator",
        "marketing-strategist -> email-marketer -> sales-closer"
      ],
      "conversion_funnel": [
        "sales-closer -> crm-manager -> onboarding-specialist -> retention-specialist"
      ],
      "feedback_loop": [
        "analytics-analyst -> marketing-strategist",
        "retention-specialist -> marketing-strategist",
        "reputation-manager -> marketing-strategist"
      ]
    },

    "execution_order": {
      "daily": [
        { "time": "06:00", "agent": "crm-manager", "workflow": "WF-CRM-SCORE", "description": "Rescore leads with inactivity decay" },
        { "time": "07:00", "agent": "content-creator", "workflow": "WF-CONTENT-SOCIAL", "description": "Generate daily social posts" },
        { "time": "07:00", "agent": "retention-specialist", "workflow": "WF-RETAIN-CHURN", "description": "Detect churn risk and generate retention actions" },
        { "time": "08:00", "agent": "media-buyer", "workflow": "WF-ADS-BUDGET", "description": "Optimize ad budgets" },
        { "time": "08:00", "agent": "email-marketer", "workflow": "WF-EMAIL-NEWSLETTER", "description": "Weekly newsletter (Thursday only)" },
        { "time": "09:00", "agent": "media-buyer", "workflow": "WF-ADS-REPORT", "description": "Daily ads performance report" },
        { "time": "09:00", "agent": "sales-closer", "workflow": "WF-SALES-FOLLOWUP", "description": "Follow up warm/hot leads" },
        { "time": "10:00", "agent": "community-manager", "workflow": "WF-COMMUNITY-ENGAGE", "description": "Morning engagement session" },
        { "time": "14:00", "agent": "community-manager", "workflow": "WF-COMMUNITY-ENGAGE", "description": "Afternoon engagement session" },
        { "time": "18:00", "agent": "community-manager", "workflow": "WF-COMMUNITY-ENGAGE", "description": "Evening engagement session" }
      ],
      "weekly": [
        { "day": "monday", "time": "06:00", "agent": "seo-specialist", "workflow": "WF-SEO-AUDIT", "description": "Technical SEO audit" },
        { "day": "monday", "time": "07:00", "agent": "seo-specialist", "workflow": "WF-SEO-KEYWORDS", "description": "Keyword research & tracking" },
        { "day": "monday", "time": "08:00", "agent": "marketing-strategist", "workflow": "WF-STRATEGY-TRENDS", "description": "Weekly trends analysis" },
        { "day": "monday", "time": "08:00", "agent": "analytics-analyst", "workflow": "WF-ANALYTICS-REPORT", "description": "Weekly analytics report" },
        { "day": "monday", "time": "09:00", "agent": "marketing-strategist", "workflow": "WF-STRATEGY-COMPETITOR", "description": "Competitor analysis" },
        { "day": "monday", "time": "08:00", "agent": "content-creator", "workflow": "WF-CONTENT-BLOG", "description": "Weekly SEO blog article" },
        { "day": "wednesday", "time": "10:00", "agent": "content-creator", "workflow": "WF-PINTEREST-INSPIRE", "description": "Weekly Pinterest inspiration & trend analysis" },
        { "day": "friday", "time": "09:00", "agent": "content-creator", "workflow": "WF-CONTENT-CALENDAR", "description": "Plan next week's editorial calendar" }
      ],
      "realtime": [
        { "trigger": "webhook", "agent": "community-manager", "workflow": "WF-COMMUNITY-COMMENTS", "description": "Respond to social media comments" },
        { "trigger": "webhook", "agent": "reputation-manager", "workflow": "WF-REPUTATION-REVIEW", "description": "Respond to online reviews" },
        { "trigger": "workflow_call", "agent": "sales-closer", "workflow": "WF-SALES-QUALIFY", "description": "Score and qualify new leads" },
        { "trigger": "workflow_call", "agent": "onboarding-specialist", "workflow": "WF-ONBOARD-WELCOME", "description": "Onboard new members" },
        { "trigger": "workflow_call", "agent": "email-marketer", "workflow": "WF-EMAIL-SEQUENCE", "description": "Trigger email sequences" },
        { "trigger": "webhook", "agent": "marketing-strategist", "workflow": "WF-STRATEGY-BRIEF", "description": "Generate campaign briefs on demand" },
        { "trigger": "workflow_call", "agent": "content-creator", "workflow": "WF-CONTENT-CANVA", "description": "Auto-generate Canva visuals for posts" },
        { "trigger": "workflow_call", "agent": "content-creator", "workflow": "WF-PINTEREST-INSPIRE", "description": "Pinterest inspiration search or pin publishing" }
      ],
      "every_4_hours": [
        { "agent": "media-buyer", "workflow": "WF-ADS-OPTIMIZE", "description": "Optimize ad campaigns" }
      ]
    },

    "notification_channels": {
      "alerts": "slack:#marketing-alerts",
      "reports": "slack:#marketing-reports",
      "crises": "slack:#marketing-urgent",
      "sales": "slack:#sales-pipeline"
    }
  }
}
