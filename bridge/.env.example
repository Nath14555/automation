# Email IMAP (pour le bridge email)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=ton-email@gmail.com
IMAP_PASSWORD=ton-app-password

# Options
SCAN_INTERVAL_MS=30000
HEADLESS=true
DEBUG=false
